<controls:FancyWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    Title="БОЕВОЙ ТЕРМИНАЛ // TRENCHFACE"
    MinSize="620 660">
    <BoxContainer Orientation="Vertical" SeparationOverride="5" Margin="5" HorizontalExpand="True">
        <PanelContainer Name="HeaderFrame" StyleClasses="BackgroundDark" HorizontalExpand="True">
            <GridContainer Columns="2" Margin="9" HorizontalExpand="True">
                <BoxContainer Orientation="Vertical" SeparationOverride="2" HorizontalExpand="True">
                    <Label Text="/// FIELD COMBAT TERMINAL ///" StyleClasses="LabelHeading" />
                    <Label Text="LIVE ORDNANCE // AUTHORIZED PERSONNEL ONLY" StyleClasses="LabelSmall" />
                    <Label Name="TargetNameLabel" Text="TARGET // UNKNOWN" StyleClasses="LabelBig" />
                    <Label Name="EngagementInfoLabel" Text="NO ACTIVE ENGAGEMENT" />
                </BoxContainer>
                <BoxContainer Orientation="Vertical" SeparationOverride="2" HorizontalExpand="True">
                    <Label Text="EQUIPPED" StyleClasses="LabelHeading" />
                    <Label Name="WeaponInfoLabel" Text="HANDS // EMPTY" />
                    <Label Text="STATUS // LIVE" StyleClasses="LabelHeading" />
                </BoxContainer>
            </GridContainer>
        </PanelContainer>

        <TabContainer Name="TabContainer" HorizontalExpand="True" VerticalExpand="True">
            <PanelContainer Name="CombatTab" StyleClasses="BackgroundDark" HorizontalExpand="True">
                <ScrollContainer VerticalExpand="True" HorizontalExpand="True" HScrollEnabled="False">
                    <BoxContainer Orientation="Vertical" SeparationOverride="7" Margin="9" HorizontalExpand="True">
                        <Label Text="ACTION SELECT // ВЫБОР ДЕЙСТВИЯ" StyleClasses="LabelHeading" />
                        <PanelContainer Name="ActionFrame" StyleClasses="BackgroundDark" HorizontalExpand="True">
                            <GridContainer Columns="2" Margin="6" HorizontalExpand="True">
                                <Button Name="ShootButton" Text="[01] FIREARM / SHOT" />
                                <Button Name="StabButton" Text="[02] MELEE / STAB" />
                                <Button Name="PunchButton" Text="[03] UNARMED / PUNCH" />
                                <Button Name="KickButton" Text="[04] UNARMED / KICK" />
                            </GridContainer>
                        </PanelContainer>

                        <PanelContainer StyleClasses="LowDivider" />
                        <PanelContainer Name="TargetZoneFrame" StyleClasses="BackgroundDark" HorizontalExpand="True" Visible="False">
                            <BoxContainer Name="BodyPartSelectionContainer" Orientation="Vertical" SeparationOverride="4" Margin="6" HorizontalExpand="True">
                            <Label Text="// TARGET ZONE" StyleClasses="LabelHeading" />
                            <GridContainer Columns="3" HorizontalExpand="True">
                                <Button Name="HeadButton" Text="HEAD" />
                                <Button Name="ChestButton" Text="TORSO" />
                                <Button Name="LeftArmButton" Text="L. ARM" />
                                <Button Name="RightArmButton" Text="R. ARM" />
                                <Button Name="LeftLegButton" Text="L. LEG" />
                                <Button Name="RightLegButton" Text="R. LEG" />
                            </GridContainer>
                            </BoxContainer>
                        </PanelContainer>
                        <Label Name="SelectionLabel" Text="ВЫБЕРИТЕ ДЕЙСТВИЕ И ЗОНУ" StyleClasses="LabelHeading" />
                        <Button Name="PerformButton" Text="CONFIRM ACTION  >>" Disabled="True" />
                    </BoxContainer>
                </ScrollContainer>
            </PanelContainer>

            <PanelContainer Name="StatusTab" StyleClasses="BackgroundDark" HorizontalExpand="True">
                <ScrollContainer VerticalExpand="True" HorizontalExpand="True" HScrollEnabled="False">
                    <BoxContainer Orientation="Vertical" SeparationOverride="7" Margin="9" HorizontalExpand="True">
                        <Label Text="TARGET DIAGNOSTICS // СОСТОЯНИЕ ЦЕЛИ" StyleClasses="LabelHeading" />
                        <BoxContainer Orientation="Horizontal" SeparationOverride="10" HorizontalExpand="True">
                            <SpriteView Name="HealthDollView" SetSize="112 168" Visible="False" />
                            <Label Name="HealthAnalyzerLabel" Text="NO VITAL DATA" HorizontalExpand="True" />
                        </BoxContainer>
                    </BoxContainer>
                </ScrollContainer>
            </PanelContainer>

            <PanelContainer Name="EquipmentTab" StyleClasses="BackgroundDark" HorizontalExpand="True">
                <ScrollContainer VerticalExpand="True" HorizontalExpand="True" HScrollEnabled="False">
                    <BoxContainer Orientation="Vertical" SeparationOverride="7" Margin="9" HorizontalExpand="True">
                        <Label Text="MEDICAL INVENTORY // МЕДИЦИНСКОЕ СНАРЯЖЕНИЕ" StyleClasses="LabelHeading" />
                        <BoxContainer Name="MedicalItemsContainer" Orientation="Vertical" SeparationOverride="3" HorizontalExpand="True" />
                        <PanelContainer StyleClasses="LowDivider" />
                        <Label Text="AMMUNITION AND CONSUMABLES" StyleClasses="LabelHeading" />
                        <Button Name="AmmunitionToggleButton" Text="OPEN INVENTORY" />
                        <BoxContainer Name="AmmunitionContainer" Orientation="Vertical" SeparationOverride="3" HorizontalExpand="True" Visible="False" />
                    </BoxContainer>
                </ScrollContainer>
            </PanelContainer>
        </TabContainer>

        <PanelContainer Name="MiniGameContainer" StyleClasses="BackgroundDark" HorizontalExpand="True" Visible="False">
            <BoxContainer Orientation="Vertical" SeparationOverride="5" Margin="9" HorizontalExpand="True">
                <Label Name="MiniGameTitleLabel" Text="ПРОВЕРКА МОМЕНТА" StyleClasses="LabelHeading" />
                <Label Name="MiniGameHintLabel" Text="ДОЖДИТЕСЬ ПОДХОДЯЩЕГО МОМЕНТА" />
                <BoxContainer Name="MiniGameVisualContainer" Orientation="Vertical" HorizontalExpand="True" HorizontalAlignment="Center" MinSize="190 190" />
                <Label Name="MiniGameStatusLabel" Text="READY" StyleClasses="LabelHeading" />
                <Button Name="MiniGameHitButton" Text="ЗАФИКСИРОВАТЬ МОМЕНТ" />
            </BoxContainer>
        </PanelContainer>

        <PanelContainer Name="TurnFrame" StyleClasses="BackgroundDark" HorizontalExpand="True">
            <GridContainer Columns="2" Margin="8" HorizontalExpand="True">
                <BoxContainer Orientation="Vertical" SeparationOverride="2">
                    <Label Text="TURN RESERVE" StyleClasses="LabelHeading" />
                    <Label Name="TurnCountLabel" Text="ДЕЙСТВИЯ // 2 ИЗ 2" StyleClasses="LabelBig" />
                </BoxContainer>
                <BoxContainer Orientation="Vertical" SeparationOverride="2">
                    <Label Text="COMBAT STATE" StyleClasses="LabelHeading" />
                    <Label Name="TurnStateLabel" Text="ГОТОВ К ДЕЙСТВИЮ" />
                    <Label Text="FIELD UNIT // TRENCHFACE SYSTEMS" StyleClasses="LabelSmall" />
                </BoxContainer>
            </GridContainer>
        </PanelContainer>
    </BoxContainer>
</controls:FancyWindow>