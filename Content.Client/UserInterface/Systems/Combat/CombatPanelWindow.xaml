<controls:FancyWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    Title="Combat"
    MinSize="300 520">
    <BoxContainer Orientation="Vertical" SeparationOverride="6" HorizontalExpand="True">
        <Label Text="ДЕЙСТВИЕ" />
        <GridContainer Columns="2" HorizontalExpand="True">
            <Button Name="ShootButton" Text="Стрелять" />
            <Button Name="StrikeButton" Text="Ударить" />
            <Button Name="PunchButton" Text="Пнуть" />
            <Button Name="StabButton" Text="Ударить ножом" />
            <Button Name="GrabButton" Text="Схватить" />
        </GridContainer>
        <Label Text="ЧАСТЬ ТЕЛА" />
        <GridContainer Columns="2" HorizontalExpand="True">
            <Button Name="HeadButton" Text="Голова" />
            <Button Name="ChestButton" Text="Грудь" />
            <Button Name="StomachButton" Text="Живот" />
            <Button Name="GroinButton" Text="Пах" />
            <Button Name="LeftShoulderButton" Text="Левое плечо" />
            <Button Name="RightShoulderButton" Text="Правое плечо" />
            <Button Name="LeftArmButton" Text="Левая рука" />
            <Button Name="RightArmButton" Text="Правая рука" />
            <Button Name="LeftHandButton" Text="Левая кисть" />
            <Button Name="RightHandButton" Text="Правая кисть" />
            <Button Name="LeftLegButton" Text="Левая нога" />
            <Button Name="RightLegButton" Text="Правая нога" />
            <Button Name="LeftFootButton" Text="Левая стопа" />
            <Button Name="RightFootButton" Text="Правая стопа" />
        </GridContainer>
        <Label Name="SelectionLabel" Text="Выбери действие и часть тела" />
        <Button Name="PerformButton" Text="Выполнить" Disabled="True" />
    </BoxContainer>
</controls:FancyWindow>
