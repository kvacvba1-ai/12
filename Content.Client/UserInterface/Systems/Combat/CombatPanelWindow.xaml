<controls:FancyWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    Title="Боевая панель"
    MinSize="360 430">
    <BoxContainer Orientation="Vertical" SeparationOverride="7" HorizontalExpand="True" Margin="4">
        <PanelContainer StyleClasses="BackgroundDark" HorizontalExpand="True">
            <BoxContainer Orientation="Vertical" SeparationOverride="3" Margin="8" HorizontalExpand="True">
                <Label Text="ПОЛЕВОЙ ПРОТОКОЛ // БОЕВОЙ КОНТАКТ" StyleClasses="LabelHeading" />
                <Label Name="TargetNameLabel" Text="Цель: неизвестно" StyleClasses="LabelBig" />
                <Label Name="EngagementInfoLabel" Text="Выберите цель" />
                <PanelContainer StyleClasses="LowDivider" />
                <Label Name="WeaponInfoLabel" Text="В руках: нет оружия" />
            </BoxContainer>
        </PanelContainer>

        <TabContainer Name="TabContainer" HorizontalExpand="True" VerticalExpand="True">
            <PanelContainer Name="CombatTab" StyleClasses="BackgroundDark" HorizontalExpand="True">
                <ScrollContainer VerticalExpand="True" HorizontalExpand="True" HScrollEnabled="False">
                    <BoxContainer Orientation="Vertical" SeparationOverride="6" Margin="6" HorizontalExpand="True">
                        <Label Text="ДЕЙСТВИЕ" StyleClasses="LabelHeading" />
                        <GridContainer Columns="2" HorizontalExpand="True">
                            <Button Name="ShootButton" Text="Выстрелить" />
                            <Button Name="StabButton" Text="Ударить ножом" />
                            <Button Name="PunchButton" Text="Ударить кулаком" />
                            <Button Name="KickButton" Text="Пнуть" />
                        </GridContainer>

                        <BoxContainer Name="BodyPartSelectionContainer" Orientation="Vertical" SeparationOverride="3" HorizontalExpand="True" Visible="False">
                            <Label Text="ВЫБОР ЧАСТИ ТЕЛА" StyleClasses="LabelHeading" />
                            <GridContainer Columns="2" HorizontalExpand="True">
                                <Button Name="HeadButton" Text="Голова" />
                                <Button Name="ChestButton" Text="Грудь" />
                                <Button Name="LeftArmButton" Text="Левая рука" />
                                <Button Name="RightArmButton" Text="Правая рука" />
                                <Button Name="LeftLegButton" Text="Левая нога" />
                                <Button Name="RightLegButton" Text="Правая нога" />
                            </GridContainer>
                        </BoxContainer>

                        <Label Name="SelectionLabel" Text="Выберите действие" />
                        <Button Name="PerformButton" Text="Выполнить действие" Disabled="True" />
                    </BoxContainer>
                </ScrollContainer>
            </PanelContainer>

            <PanelContainer Name="StatusTab" StyleClasses="BackgroundDark" HorizontalExpand="True">
                <ScrollContainer VerticalExpand="True" HorizontalExpand="True" HScrollEnabled="False">
                    <BoxContainer Orientation="Vertical" SeparationOverride="6" Margin="6" HorizontalExpand="True">
                        <Label Text="СОСТОЯНИЕ ЦЕЛИ" StyleClasses="LabelHeading" />
                        <BoxContainer Orientation="Horizontal" SeparationOverride="8" HorizontalExpand="True">
                            <SpriteView Name="HealthDollView" SetSize="88 132" Visible="False" />
                            <Label Name="HealthAnalyzerLabel" Text="Нет данных" HorizontalExpand="True" />
                        </BoxContainer>
                    </BoxContainer>
                </ScrollContainer>
            </PanelContainer>

            <PanelContainer Name="EquipmentTab" StyleClasses="BackgroundDark" HorizontalExpand="True">
                <ScrollContainer VerticalExpand="True" HorizontalExpand="True" HScrollEnabled="False">
                    <BoxContainer Orientation="Vertical" SeparationOverride="6" Margin="6" HorizontalExpand="True">
                        <Label Text="МЕДИЦИНСКИЕ СРЕДСТВА" StyleClasses="LabelHeading" />
                        <BoxContainer Name="MedicalItemsContainer" Orientation="Vertical" SeparationOverride="3" HorizontalExpand="True" />
                        <PanelContainer StyleClasses="LowDivider" />
                        <Button Name="AmmunitionToggleButton" Text="Показать боеприпасы" />
                        <BoxContainer Name="AmmunitionContainer" Orientation="Vertical" SeparationOverride="3" HorizontalExpand="True" Visible="False" />
                    </BoxContainer>
                </ScrollContainer>
            </PanelContainer>
        </TabContainer>

        <PanelContainer StyleClasses="BackgroundDark" HorizontalExpand="True">
            <BoxContainer Orientation="Vertical" SeparationOverride="3" Margin="8" HorizontalExpand="True">
                <Label Name="TurnCountLabel" Text="ОСТАЛОСЬ ДЕЙСТВИЙ: 2/2" StyleClasses="LabelBig" />
                <Label Name="TurnStateLabel" Text="Можно действовать" StyleClasses="LabelHeading" />
            </BoxContainer>
        </PanelContainer>
    </BoxContainer>
</controls:FancyWindow>
